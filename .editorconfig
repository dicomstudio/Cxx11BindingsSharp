root = true

# Default settings
[*]
charset = utf-8
indent_style = space
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

[*.{h,cs,c,cxx,hxx}]
insert_final_newline = true

[CMakeLists.txt]
indent_size = 2
