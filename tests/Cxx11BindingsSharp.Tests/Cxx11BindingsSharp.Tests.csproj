<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition="'$(VisualStudioVersion)'=='16.0'">
        <TargetFramework>net6.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(VisualStudioVersion)'!='16.0'">
        <TargetFrameworks>net48;net6.0;net8.0</TargetFrameworks>
    </PropertyGroup>

    <!-- Dump version for clarity -->
    <Target Name="TestVersion" AfterTargets="build">
        <Message Text="version=>$(VisualStudioVersion)" Importance="high"/>
    </Target>

    <!-- common stuff -->
    <PropertyGroup>
        <Platforms>AnyCPU;x64;x86</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(NativeTestLibraryPath)' != ''">
        <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Cxx11BindingsSharp\Cxx11BindingsSharp.csproj"/>
    </ItemGroup>

    <!-- Dump version for clarity -->
    <Target Name="TestVersion" AfterTargets="build">
        <Message Text="RuntimeIdentifier=>$(RuntimeIdentifier)" Importance="high"/>
        <Message Text="OS=>$(OS)" Importance="high"/>
    </Target>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NativeTestLibraryPath)' == ''">
        <NativeTestSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\native'))</NativeTestSourceDir>
        <NativeTestPlatform>x64</NativeTestPlatform>
        <NativeTestPlatform Condition="'$(Platform)' == 'x86'">Win32</NativeTestPlatform>
    </PropertyGroup>

    <Target Name="BuildNativeTestLibrary" BeforeTargets="CopyFilesToOutputDirectory"
            Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(NativeTestLibraryPath)' == ''">
        <PropertyGroup>
            <NativeTestBuildDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)native'))</NativeTestBuildDir>
        </PropertyGroup>
        <Exec Command="cmake -S &quot;$(NativeTestSourceDir)&quot; -B &quot;$(NativeTestBuildDir)&quot; -A $(NativeTestPlatform) -DBUILD_TESTING=OFF" />
        <Exec Command="cmake --build &quot;$(NativeTestBuildDir)&quot; --config &quot;$(Configuration)&quot; --target Cxx11Bindings_module" />
        <PropertyGroup>
            <NativeTestLibraryPath>$(NativeTestBuildDir)\lib\$(Configuration)\Cxx11BindingsTests.dll</NativeTestLibraryPath>
        </PropertyGroup>
    </Target>

    <Target Name="CopyNativeTestLibrary" BeforeTargets="CopyFilesToOutputDirectory"
            DependsOnTargets="BuildNativeTestLibrary" Condition="'$(NativeTestLibraryPath)' != '' or $([MSBuild]::IsOSPlatform('Windows'))">
        <Error Condition="!Exists('$(NativeTestLibraryPath)')" Text="Native test library not found: $(NativeTestLibraryPath)" />
        <Copy SourceFiles="$(NativeTestLibraryPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.6.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.5"/>
    </ItemGroup>
</Project>
