<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Condition="'$(VisualStudioVersion)'=='16.0'">
        <TargetFramework>net6.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(VisualStudioVersion)'=='17.0'">
        <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    </PropertyGroup>

    <!-- Dump version for clarity -->
    <Target Name="TestVersion" AfterTargets="build">
        <Message Text="version=>$(VisualStudioVersion)" Importance="high"/>
    </Target>

    <PropertyGroup>
        <Platforms>AnyCPU;x64;x86</Platforms>
        <Nullable>enable</Nullable>
        <Authors>DicomStudio</Authors>
        <PackageTags>native;C++11;Stream</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Version>0.0.0</Version>
        <Description>Provide a thin layer to wrap a System.IO.Stream in C# to a portable C++ stream (std::streambuf).
            Akin to System.Runtime.InteropServices.ComTypes.IStream on windows.</Description>
        <PackageProjectUrl>https://github.com/dicomstudio/Cxx11BindingsSharp/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/dicomstudio/Cxx11BindingsSharp.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright 2025 DicomStudio</Copyright>
        <!-- required for the symbols stuff -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IncludeSource>true</IncludeSource>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <!-- https://learn.microsoft.com/en-us/dotnet/core/project-sdk/msbuild-props#continuousintegrationbuild -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../native/cxx11bindings.h" Pack="true" PackagePath="build/native/include"/>
        <None Include="../../native/cxx11bindings.hxx" Pack="true" PackagePath="build/native/include"/>
        <None Include="../../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
